PUID=1000
PGID=1000
TZ=America/Los_Angeles
APPDATA=/opt/docker
CONNET=dbr0
IMAGE_TAG=latest

#ODIC
OIDC_REDIRECT_DOMAIN= # redirect domain/ip (+ port) for oidc, without scheme and without path, redirect url will be https://$OIDC_REDIRECT_DOMAIN/api/oidc/callback
OIDC_ISSUER_URL= # issuer url for oidc
OIDC_CLIENT_ID= # client id for oidc
OIDC_CLIENT_SECRET= # client secret for oidc
OIDC_REQUIRE_VERIFIED_EMAIL=true # requires the email sent by the OIDC Provider to be marked as verified, default true
OIDC_DISABLE_PASSWORD=false # disables plain email/password login, default false
OIDC_SKIP_MFA=false # skips the second factor after a successful OIDC login, default false